# ==========================================
# TU TURNO BARBER - VARIABLES DE ENTORNO
# ==========================================

# Servidor HTTP
PORT=3001
NODE_ENV=development

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=barberia_db
DB_USER=root
DB_PASSWORD=root
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true

# Seguridad y Autenticación JWT
JWT_SECRET=tu_turno_barber_ultra_secure_jwt_secret_2026_xK9#mQ!
JWT_EXPIRES_IN=24h

# Seguridad Web / CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Archivos y Uploads
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=uploads

# Fallback en desarrollo cuando MySQL local no está levantado
DB_MOCK_FALLBACK=true
